---
// /en/ 现在是英文的别名地址，正文在根上（locales.json 里 en 的 dir 是空串）。
// README 和别处早就散着 /en/ 的链接，不给这一页就是一批 404。
// meta refresh 带着查询串和锚点一起去根上，关掉 JS 也照样跳；
// canonical 指根上那一页：别名不是另一本书，搜索引擎按 canonical 归并。
import { SITE } from '../../../tools/site/build.mjs';
const root = SITE + '/';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>HowToLiveBetter</title>
<meta name="robots" content="noindex,follow">
<link rel="canonical" href={root}>
<meta http-equiv="refresh" content="0; url=../">
<style>
body{font:16px/1.7 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
  margin:0;min-height:100vh;display:grid;place-items:center;background:#fff;color:#1b1b1f}
main{max-width:520px;padding:32px 20px;text-align:center}
p{color:rgba(60,60,67,.72);margin:0 0 18px}
a{color:#3451b2;text-decoration:none;font-weight:600}
@media (prefers-color-scheme: dark){
  body{background:#1b1b1f;color:#f6f6f7}p{color:rgba(235,235,245,.68)}a{color:#93a8ef}}
</style>
<script>
// meta refresh 只带地址不带锚点，这里补上：筛选参数 ?q= 和 #e-xx-y 定位都留在原地。
// ../ 是相对地址，换域名不用改这里（绝对地址在 canonical 上，改域名只改 site.json）。
location.replace('../' + location.search + location.hash);
</script>
</head>
<body><main>
<p>The English edition now lives at the site root.</p>
<a href={root}>Continue to the English edition</a>
</main></body>
</html>
